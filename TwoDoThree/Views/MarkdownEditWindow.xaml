<Window x:Class="TwoDoThree.Views.MarkdownEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Edit Markdown" Icon="../Assets/AppIcon.ico"
        Width="900" Height="650" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PathBlock" TextWrapping="Wrap" Margin="0,0,0,10" />
        <avalonEdit:TextEditor x:Name="SourceEditor" Grid.Row="1"
                              FontFamily="Consolas" FontSize="14" ShowLineNumbers="True"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              TextChanged="SourceEditor_TextChanged" />
        <TextBlock x:Name="StatusBlock" Grid.Row="2" TextWrapping="Wrap" Margin="0,10,0,8"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Padding="16,6" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="Save" Padding="16,6" Margin="8,0,0,0" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
